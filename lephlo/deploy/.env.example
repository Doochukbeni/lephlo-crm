# Copy to .env and fill in. Generate secrets with: openssl rand -base64 32
# Never commit .env or anything in ./secrets.

# --- Versions (pin both; upgrade deliberately) ---
LEPHLO_TAG=sha-xxxxxxx            # tag from ghcr.io/doochukbeni/lephlo-crm
DOCUMENSO_TAG=                    # a specific Documenso release, never "latest"

# --- Domains ---
CRM_DOMAIN=crm.example.com
SIGN_DOMAIN=sign.example.com
ACME_EMAIL=ops@example.com

# --- Lephlo CRM database ---
PG_DATABASE_NAME=lephlo
PG_DATABASE_USER=lephlo
PG_DATABASE_PASSWORD=             # letters and digits only

# --- Lephlo CRM secrets ---
ENCRYPTION_KEY=
FALLBACK_ENCRYPTION_KEY=          # only while rotating ENCRYPTION_KEY

# --- Storage (local is fine on one VPS; use S3 once backups matter) ---
STORAGE_TYPE=local
STORAGE_S3_REGION=
STORAGE_S3_NAME=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# --- System email (Resend SMTP: host smtp.resend.com, user "resend", password = API key) ---
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Lephlo
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=resend
EMAIL_SMTP_PASSWORD=

# --- Google Workspace (login + Gmail/Calendar sync for client-facing email) ---
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
MESSAGING_PROVIDER_GMAIL_ENABLED=false
CALENDAR_PROVIDER_GOOGLE_ENABLED=false

# --- AI ---
ANTHROPIC_API_KEY=

# --- Error tracking (optional) ---
EXCEPTION_HANDLER_DRIVER=CONSOLE  # set to SENTRY with the DSNs below
SENTRY_DSN=
SENTRY_FRONT_DSN=
SENTRY_ENVIRONMENT=production

# --- Documenso ---
DOCUMENSO_DB_NAME=documenso
DOCUMENSO_DB_USER=documenso
DOCUMENSO_DB_PASSWORD=
DOCUMENSO_NEXTAUTH_SECRET=
DOCUMENSO_ENCRYPTION_KEY=
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=
DOCUMENSO_FROM_ADDRESS=sign@example.com
DOCUMENSO_SIGNING_PASSPHRASE=     # passphrase of ./secrets/documenso-cert.p12

# --- Backups (lephlo/deploy/backup.sh) ---
BACKUP_DIR=/var/backups/lephlo
BACKUP_RETENTION_DAYS=14
BACKUP_RCLONE_REMOTE=             # e.g. b2:lephlo-backups ; empty = local only
