{
	email {$ACME_EMAIL}
	order rate_limit before reverse_proxy
}

# Headers for both sites. HSTS: browsers only use HTTPS for a year (no
# preload, so it can still be undone). The rest stops MIME sniffing, keeps
# full URLs out of Referer headers and hides the server software.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
		-Via
	}
}

{$CRM_DOMAIN} {
	encode zstd gzip
	import security_headers

	# A deliberately small CSP that doesn't fight Twenty (inline styles,
	# workers, blob: previews, front components): no framing by other sites
	# (clickjacking), no <base> hijacking, no plugins. Camera, location and
	# payment are off; the microphone stays on for the AI chat's dictation.
	header {
		Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), geolocation=(), payment=(), usb=(), microphone=(self)"
	}

	# App public routes (client portal, lead capture, Stripe/Documenso webhooks)
	# are unauthenticated, so they get a per-IP budget.
	rate_limit {
		zone public_app_routes {
			match {
				path /s/*
			}
			key {remote_host}
			events 60
			window 1m
		}
	}

	reverse_proxy server:3000
}

{$SIGN_DOMAIN} {
	encode zstd gzip
	import security_headers
	reverse_proxy documenso:3000
}
